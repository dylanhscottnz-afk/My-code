from pathlib import Path

def Find_File(Name):
    workspace = Path(".")
    AllJsonFiles = list(workspace.rglob("*.json"))
    for File in AllJsonFiles:
        if File.name == Name:
            return File
            
    return None

def Load_File(Name):
    with open(Name, "r", encoding="utf-8") as file:
        data = json.load(file)
        return {int(k) if k.isdigit() else k: v for k, v in data.items()}

